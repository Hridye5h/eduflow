# --- Database / Redis ---
DATABASE_URL="postgresql://eduflow:eduflowpass@localhost:5433/eduflow?schema=public"
REDIS_URL="redis://localhost:6380"

# --- App ---
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4001
NODE_ENV=development
ENABLE_SWAGGER=true

# ---- Test helpers ----
# When "true", exposes GET /_test/last-otp?identifier=... returning the most
# recent plaintext OTP for that identifier. Used by e2e tests. Also enabled
# automatically by CI. NEVER set this in production.
ENABLE_TEST_HELPERS=false

# CORS: comma-separated list of allowed origins (defaults to allow-all in dev)
CORS_ORIGINS="http://localhost:3001,https://eduflow-web.vercel.app"

# Subdomain config — schools resolve via Host header
ROOT_DOMAIN="eduflow.local"

# ---- Email (any SMTP provider) ----
# Examples:
#   Gmail:   host=smtp.gmail.com port=587 user=you@gmail.com pass=<App Password>
#   Resend:  host=smtp.resend.com port=587 user=resend pass=<RESEND_API_KEY>
#   SendGrid:host=smtp.sendgrid.net port=587 user=apikey pass=<SENDGRID_API_KEY>
#   Brevo:   host=smtp-relay.brevo.com port=587 user=<login> pass=<smtp_key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EduFlow <noreply@eduflow.app>"

# ---- Cloudinary (file uploads) ----
# Sign up at https://cloudinary.com (free 25GB). Find these on the dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
